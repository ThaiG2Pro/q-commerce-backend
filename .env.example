# Database
DATABASE_URL=postgresql://neondb_owner:PASSWORD@HOST/neondb?sslmode=require

# Redis (event bus, caching, workflow engine)
REDIS_URL=rediss://default:PASSWORD@HOST:6379

# CORS
STORE_CORS=http://localhost:8000,http://localhost:9000,http://localhost:3000
ADMIN_CORS=http://localhost:5173,http://localhost:9000,http://localhost:3000
AUTH_CORS=http://localhost:5173,http://localhost:9000,http://localhost:8000,http://localhost:3000

# Secrets (thay đổi khi deploy prod)
JWT_SECRET=change-me-in-production
COOKIE_SECRET=change-me-in-production

# QR Payment
QR_CODE_URL=https://res.cloudinary.com/dmir82slh/image/upload/v1776360198/1808989582646373803_rypema.jpg

# Fulfillment
WAREHOUSE_ADDRESS=123 Main Street, HCM City
WAREHOUSE_PHONE=+84123456789
WAREHOUSE_EMAIL=warehouse@company.com

# Analytics (PostHog)
POSTHOG_EVENTS_API_KEY=phc_...
POSTHOG_HOST=https://app.posthog.com

# Storefront profile (optional)
STOREFRONT_SHOP_NAME=
STOREFRONT_SHOP_ADDRESS=
STOREFRONT_LOGO_URL=
